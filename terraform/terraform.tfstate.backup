            "source_dest_check": true,
            "spot_instance_request_id": "",
            "subnet_id": "subnet-035cb8ca9a93df6dc",
            "tags": {
              "Name": "ecommerce-store-server"
            },
            "tags_all": {
              "Name": "ecommerce-store-server"
            },
            "tenancy": "default",
            "timeouts": null,
            "user_data": "#!/bin/bash\n\nset -e\n\napt-get update -y\n\napt-get install -y docker.io\n\nsystemctl enable docker\nsystemctl start docker\n\nusermod -aG docker ubuntu\n\n# Wait for Docker\nsleep 10\n\n# Pull images\ndocker pull suhailm67/ecommerce-user:latest\ndocker pull suhailm67/ecommerce-product:latest\ndocker pull suhailm67/ecommerce-cart:latest\ndocker pull suhailm67/ecommerce-order:latest\ndocker pull suhailm67/ecommerce-frontend:latest\n\n# Create application network\ndocker network create ecommerce-network || true\n\n# MongoDB\ndocker run -d \\\n  --name mongodb \\\n  --network ecommerce-network \\\n  --restart unless-stopped \\\n  mongo:7\n\n# User service\ndocker run -d \\\n  --name user-service \\\n  --network ecommerce-network \\\n  --restart unless-stopped \\\n  -p 3001:3001 \\\n  -e PORT=3001 \\\n  -e MONGODB_URI=mongodb://mongodb:27017/ecommerce_users \\\n  -e JWT_SECRET=production-secret \\\n  suhailm67/ecommerce-user:latest\n\n# Product service\ndocker run -d \\\n  --name product-service \\\n  --network ecommerce-network \\\n  --restart unless-stopped \\\n  -p 3002:3002 \\\n  -e PORT=3002 \\\n  -e MONGODB_URI=mongodb://mongodb:27017/ecommerce_products \\\n  suhailm67/ecommerce-product:latest\n\n# Cart service\ndocker run -d \\\n  --name cart-service \\\n  --network ecommerce-network \\\n  --restart unless-stopped \\\n  -p 3003:3003 \\\n  -e PORT=3003 \\\n  -e MONGODB_URI=mongodb://mongodb:27017/ecommerce_carts \\\n  -e PRODUCT_SERVICE_URL=http://product-service:3002 \\\n  suhailm67/ecommerce-cart:latest\n\n# Order service\ndocker run -d \\\n  --name order-service \\\n  --network ecommerce-network \\\n  --restart unless-stopped \\\n  -p 3004:3004 \\\n  -e PORT=3004 \\\n  -e MONGODB_URI=mongodb://mongodb:27017/ecommerce_orders \\\n  -e CART_SERVICE_URL=http://cart-service:3003 \\\n  -e PRODUCT_SERVICE_URL=http://product-service:3002 \\\n  -e USER_SERVICE_URL=http://user-service:3001 \\\n  suhailm67/ecommerce-order:latest\n\n# Frontend\ndocker run -d \\\n  --name frontend \\\n  --network ecommerce-network \\\n  --restart unless-stopped \\\n  -p 80:80 \\\n  suhailm67/ecommerce-frontend:latest\n\necho \"E-Commerce application deployment complete\"",
            "user_data_base64": null,
            "user_data_replace_on_change": false,
            "volume_tags": null,
            "vpc_security_group_ids": [
              "sg-05f557d2080d3c251"
            ]
          },
